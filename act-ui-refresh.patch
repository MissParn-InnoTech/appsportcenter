+/* ============================================================
+   MODERN PAGE KIT (.m-page) — ปฏิทิน / โปรไฟล์ / สถานที่ /
+   คลังความรู้ / รายงาน : พื้นเทากลางเต็มพื้นที่เนื้อหา มุมโค้ง
+   ============================================================ */
+.app-shell .m-page {
+  max-width: none;
+  margin: -1rem -1rem calc(-4.5rem - env(safe-area-inset-bottom));
+  padding: 1.25rem 1rem calc(5.5rem + env(safe-area-inset-bottom));
+  min-height: calc(100% + 5.5rem + env(safe-area-inset-bottom));
+  font-size: 14px;
+  line-height: 1.5;
+}
+@media (min-width: 768px) {
+  .app-shell .m-page { padding: 1.75rem 2rem calc(5.5rem + env(safe-area-inset-bottom)); }
+}
+/* ค่าเริ่มต้นมุมโค้งภายในหน้าแบบใหม่ (specificity ต่ำ — คลาส/inline ทับได้) */
+:where(.m-page) button, :where(.m-page) input, :where(.m-page) select, :where(.m-page) textarea { border-radius: 10px; }
+:where(.m-page) [style*="border: 1px solid"], :where(.m-page) [style*="border: 1px dashed"] { border-radius: 12px; }
+:where(.m-page) input, :where(.m-page) select { min-height: 42px; }
+.m-page :focus-visible { outline: 2px solid #C81E3A; outline-offset: 2px; }
+@media print {
+  .app-shell .m-page { margin: 0 !important; padding: 0 !important; min-height: 0 !important; background: #fff !important; }
